<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Header. -->
    <string name="cart_title">Carrito</string>
    <string name="cart_close_cd">Cerrar carrito</string>
    <plurals name="cart_subtitle_count">
        <item quantity="one">%d producto guardado</item>
        <item quantity="other">%d productos guardados</item>
    </plurals>

    <!-- Empty state. -->
    <string name="cart_empty_message">Tu carrito está vacío</string>
    <string name="cart_empty_hint">Agrega productos para realizar tu pedido.</string>

    <!-- Cart line. -->
    <string name="cart_line_remove_cd">Quitar producto del carrito</string>
    <string name="cart_go_to_detail">Ver detalle</string>
    <string name="cart_go_to_detail_cd">Ver el detalle del producto</string>

    <!-- Consumer-data form. -->
    <string name="cart_form_title">Completa tus datos para continuar</string>
    <string name="cart_name_label">Nombres</string>
    <string name="cart_name_placeholder">Nombres</string>
    <string name="cart_name_error">Ingresa al menos un nombre</string>
    <string name="cart_phone_label">Número de celular</string>
    <string name="cart_phone_placeholder">Ej. 987 654 321</string>
    <string name="cart_phone_error">Ingresa un número de celular válido</string>

    <!-- Totals (receipt). -->
    <plurals name="cart_subtotal_label">
        <item quantity="one">Subtotal (%d producto)</item>
        <item quantity="other">Subtotal (%d productos)</item>
    </plurals>
    <string name="cart_total_label">Total</string>

    <!-- Actions. -->
    <string name="cart_place_order">Realizar pedido</string>
    <string name="cart_keep_shopping">Seguir buscando</string>
    <string name="cart_share_whatsapp_cd">Compartir por WhatsApp</string>

    <!-- Order submission — loading. -->
    <string name="cart_submitting_cd">Generando tu pedido…</string>

    <!-- Order submission — success. -->
    <string name="cart_success_title">¡Pedido generado con éxito!</string>
    <string name="cart_success_subtitle">Acércate al vendedor para recibir tu pedido y realizar el pago.</string>
    <string name="cart_success_check_phone">Revisa tu celular para ver el detalle de tu pedido.</string>
    <!-- Order created but the WhatsApp quote could not be delivered after retrying. -->
    <string name="cart_success_share_failed_subtitle">Se generó tu pedido. Acércate al vendedor e indícale tu nombre para revisar tu orden.</string>
    <plurals name="cart_success_qty">
        <item quantity="one">Cantidad: %d</item>
        <item quantity="other">Cantidad: %d</item>
    </plurals>
    <string name="cart_success_accept">Aceptar</string>

    <!-- "Compartir por WhatsApp" — quote delivered (status SENT). No order exists. -->
    <string name="cart_share_success_title">¡Cotización enviada!</string>
    <string name="cart_share_success_subtitle">Acércate al vendedor para recibir tus productos y realizar el pago.</string>
    <string name="cart_share_success_check_phone">Revisa tu celular para ver la cotización.</string>

    <!-- "Compartir por WhatsApp" — the server answered but WhatsApp did not receive the quote. -->
    <string name="cart_share_not_delivered_title">No pudimos enviar la cotización</string>
    <string name="cart_share_not_delivered_message">La cotización no llegó a tu WhatsApp. Acércate al vendedor para que te ayude.</string>

    <!-- "Compartir por WhatsApp" — rejected or failed after its retries. Keeps the basket. -->
    <string name="cart_share_error_title">No pudimos enviar la cotización</string>
    <string name="cart_share_error_message">Hubo un problema enviando la cotización. Inténtalo de nuevo en unos momentos.</string>

    <!-- A product the server no longer accepts (inactive, not AVAILABLE or gone), found after a 400/404. -->
    <string name="cart_line_unavailable">No disponible</string>
    <string name="cart_unavailable_message">Algunos productos ya no están disponibles. Quítalos del carrito para continuar.</string>

    <!-- Order submission — error. -->
    <string name="cart_error_title">Algo salió mal</string>
    <string name="cart_error_message">Hubo un problema generando la orden. Inténtalo de nuevo en unos momentos.</string>
    <string name="cart_error_understood">Entendido</string>
    <string name="cart_error_cancel">Cancelar orden</string>
    <!-- Order error by cause (order-price-check). -->
    <string name="cart_error_network_message">No pudimos enviar tu pedido porque la tablet no tiene internet. Tu carrito sigue guardado; inténtalo de nuevo en un momento.</string>
    <string name="cart_error_back_to_cart">Volver al carrito</string>
    <string name="cart_error_timeout_message">No pudimos confirmar si tu pedido se registró. Pregúntale al vendedor antes de intentarlo de nuevo.</string>
    <string name="cart_error_validation_name">Revisa tu nombre (máximo 200 caracteres).</string>
    <string name="cart_error_validation_phone">Revisa tu número de celular.</string>
    <string name="cart_error_validation_items">Tu carrito está vacío o tiene demasiados productos.</string>

    <!-- Share without network (order-price-check). -->
    <string name="cart_share_error_network_message">No pudimos enviar la cotización porque la tablet no tiene internet. Tu carrito sigue guardado; inténtalo de nuevo en un momento.</string>

    <!-- Basket changes made on the customer's behalf (order-price-check). %1$s product, %2$s old price, %3$s new price. -->
    <string name="cart_notice_price_changed">El precio de «%1$s» cambió de %2$s a %3$s. Revisa el total antes de hacer tu pedido.</string>
    <plurals name="cart_notice_price_more">
        <item quantity="one">y %d producto más cambió de precio.</item>
        <item quantity="other">y %d productos más cambiaron de precio.</item>
    </plurals>
    <string name="cart_notice_items_removed">Quitamos de tu carrito lo que ya no está disponible: %1$s.</string>
    <!-- %1$d units left, %2$s product. -->
    <string name="cart_notice_quantity_capped">Solo quedan %1$d de «%2$s»; ajustamos la cantidad.</string>

    <!-- Success with what the store recorded (order-price-check). %1$s formatted amount. -->
    <string name="cart_success_total_label">Total del pedido  %1$s</string>
    <string name="cart_success_total_mismatch">El total registrado por la tienda es %1$s, distinto del que viste en el carrito. Confírmalo con el vendedor.</string>
</resources>
