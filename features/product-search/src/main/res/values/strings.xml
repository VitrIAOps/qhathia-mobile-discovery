<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Processing messages (animated 3-dot indicator appends the dots; base text only here).
         Shared voice copy (Escuchando / Organizando ideas / slow response) lives in core:ui. -->
    <string name="ps_searching">Revisando catálogo</string>
    <string name="ps_slow_search">Buscando minuciosamente</string>

    <!-- Results headline — count is filled in client-side. -->
    <plurals name="ps_results_headline">
        <item quantity="one">Encontré %1$d producto para ti:</item>
        <item quantity="other">Encontré %1$d productos para ti:</item>
    </plurals>
    <!-- The selected chips left no product (F-37); the chips stay selected. -->
    <string name="ps_filters_no_match">No hay productos con esos filtros. Quita alguno para ver más.</string>
    <!-- The store does not sell the requested product; the results are alternatives. %1$s product. -->
    <string name="ps_alternatives_only">No tenemos «%1$s»; te mostramos alternativas.</string>

    <!-- Filters & suggestions refine section (results screen). -->
    <string name="ps_refine_title">Afina tu búsqueda</string>
    <string name="ps_refine_subtitle">Usa los filtros para encontrar exactamente lo que necesitas.</string>
    <string name="ps_suggestions_title">Sugerencias</string>
    <string name="ps_refine_icon_cd">Filtros</string>
    <string name="ps_suggestions_icon_cd">Sugerencias</string>
    <!-- Per-criterion clear control. -->
    <string name="ps_filter_clear">Limpiar</string>
    <!-- %1$s = criterion. -->
    <string name="ps_filter_clear_cd">Limpiar filtro %1$s</string>
    <!-- %1$s = criterion, %2$s = option. -->
    <string name="ps_filter_option_cd">Filtrar por %1$s: %2$s</string>
    <string name="ps_suggestion_cd">Sugerencia: %1$s</string>

    <!-- Unhappy (no results / search error) screen. The apology, then an invite line that is generic
         or personalized from the category (%1$s = category, verbatim from the API). -->
    <string name="ps_unhappy_message">Lo siento, no pude encontrar lo que estás buscando.</string>
    <string name="ps_unhappy_invite">De pronto te interesaría…</string>
    <string name="ps_unhappy_invite_category">Relacionado a \'%1$s\' te podría interesar…</string>

    <!-- Bottom search bar (feature-specific prompt). -->
    <string name="ps_prompt">Cuéntame más</string>

    <!-- Close-current-search confirmation dialog (feature-specific title/message). -->
    <string name="ps_close_dialog_title">¿Cerrar la búsqueda actual?</string>
    <string name="ps_close_dialog_message">Se cerrará la búsqueda y volverás al inicio.</string>
</resources>
