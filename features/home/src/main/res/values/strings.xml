<resources>
    <!-- Store identity slot (top-left). Falls back to this when the session has no store name. -->
    <string name="home_store_name_placeholder">TIENDA</string>

    <!-- Idle hero copy -->
    <string name="home_title">Encuentra lo que necesitas</string>
    <string name="home_subtitle">Presiona aquí y describe lo que buscas, por nombre o detalles</string>

    <!-- Search (feature-specific placeholder; shared search-icon CD lives in core:ui) -->
    <string name="home_search_placeholder">Describe lo que buscas (taladro de la marca bosch)</string>

    <!-- Controls -->
    <string name="home_catalog">Ir al catálogo</string>
    <string name="home_catalog_cd">Ir al catálogo</string>
    <string name="home_settings_cd">Ajustes</string>

    <!-- Microphone content descriptions (shared "Buscar por voz" CD lives in core:ui) -->
    <string name="home_mic_listening_cd">Escuchando, toca para detener</string>
    <string name="home_mic_retry_cd">Toca para intentar de nuevo</string>
    <string name="home_mic_processing_cd">Procesando, toca para cancelar</string>

    <!-- Microphone permission -->

    <!-- Voice-search error screens (rendered with the same headline + mic + search layout as the
         no-audio retry; the mic re-triggers the search). Shared network-error and generic-error
         titles live in core:ui; the feature-specific messages remain here. -->
    <string name="stt_error_audio_too_long_title">¿Podrías resumir?</string>
    <string name="stt_error_audio_too_long_message">Las grabaciones breves funcionan mejor. Intenta resumir tu búsqueda unos segundos.</string>

    <string name="stt_error_transcription_title">No alcancé a entender…</string>
    <string name="stt_error_transcription_message">Hubo un problema al procesar la idea. Intenta hablar más claro cuando grabes.</string>

    <string name="stt_error_empty_audio_title">No te escuché…</string>
    <string name="stt_error_empty_audio_message">Intenta hablar un poco más cerca del micrófono y vuelve a grabar.</string>

    <string name="stt_error_timeout_title">La respuesta está tardando demasiado</string>
    <string name="stt_error_timeout_message">Al parecer hay demoras al procesar la idea. Intenta nuevamente en unos momentos.</string>

    <string name="stt_error_generic_message">No pude completar tu solicitud. Por favor intenta nuevamente.</string>

    <!-- Footer -->
    <string name="home_powered_by">powered by</string>
    <string name="home_brand">Qhathia</string>

    <!-- Multiple retry titles the assistant cycles through when no audio is detected. -->
    <string-array name="home_retry_titles">
        <item>No te escuché…</item>
        <item>Sigo sin escucharte…</item>
        <item>¿Probamos otra vez?</item>
        <item>No capté el audio…</item>
    </string-array>
    <!-- Subtitles aligned by index with home_retry_titles. -->
    <string-array name="home_retry_subtitles">
        <item>Inténtalo de nuevo, describe lo que buscas por nombre o detalles</item>
        <item>Acércate y describe lo que buscas, por nombre o detalles</item>
        <item>Toca el micrófono y dime qué producto necesitas</item>
        <item>Vuelve a intentarlo: ¿qué producto estás buscando?</item>
    </string-array>
</resources>
