<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voice search: capture microphone audio and reach the Qhathia + Deepgram APIs. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Network settings: read Wi-Fi state/scan results and request Wi-Fi changes. Reading scan
         results requires location (a dangerous permission, requested at runtime in the screen). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Android 12+ requires COARSE alongside FINE; either grant lets us read Wi-Fi scan results. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Boot autostart (boot-autostart, F-12): open the showcase when the tablet finishes booting. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".DiscoveryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.QhathiaDiscovery">
        <!-- Business rule: landscape only (design D12). Android 16 ignores screenOrientation on large
             screens (smallest width >= 600 dp) for apps targeting SDK 36; this property opts out.
             Google removes the opt-out at target SDK 37: before raising targetSdk to 37, the
             landscape rule must rely on the device setup (workspace docs/android/tablet-kiosk-setup.md). -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <!-- Fixed landscape, not sensorLandscape: the rule is "no rotation". -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.QhathiaDiscovery"
            android:windowSoftInputMode="stateHidden"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Selectable as the device home screen (boot-autostart D1): on Android 10+ this is how
                 the showcase comes back after a reboot. Keep the default launchMode: the RESTART_APP
                 trampoline relies on it (F-09). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Device owner component (F-10): lets the app pin without the "Pin app?" dialog once
             operation runs `dpm set-device-owner`. Exported, guarded by BIND_DEVICE_ADMIN. -->
        <receiver
            android:name=".kiosk.KioskDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <!-- Opens the showcase after a reboot on Android 9 and earlier (boot-autostart D2). -->
        <receiver
            android:name=".boot.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- RESTART_APP trampoline (design D7): own process, joins the pinned task, kills the main
             process and starts MainActivity again. Opaque theme: a translucent activity cannot fix
             its orientation on API 26. -->
        <activity
            android:name=".RestartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":restart"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.QhathiaDiscovery"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
    </application>

</manifest>