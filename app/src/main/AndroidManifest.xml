<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voice search: capture microphone audio and reach the Qhathia + Deepgram APIs. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Network settings: read Wi-Fi state/scan results and request Wi-Fi changes. Reading scan
         results requires location (a dangerous permission, requested at runtime in the screen). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Android 12+ requires COARSE alongside FINE; either grant lets us read Wi-Fi scan results. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".DiscoveryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.QhathiaDiscovery">
        <!-- Business rule: landscape only (design D12). Android 16 ignores screenOrientation on large
             screens (smallest width >= 600 dp) for apps targeting SDK 36; this property opts out.
             Google removes the opt-out at target SDK 37: before raising targetSdk to 37, the
             landscape rule must rely on the device setup (docs/android/tablet-kiosk-setup.md). -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <!-- Fixed landscape, not sensorLandscape: the rule is "no rotation". -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.QhathiaDiscovery"
            android:windowSoftInputMode="stateHidden"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- RESTART_APP trampoline (design D7): own process, joins the pinned task, kills the main
             process and starts MainActivity again. Opaque theme: a translucent activity cannot fix
             its orientation on API 26. -->
        <activity
            android:name=".RestartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":restart"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.QhathiaDiscovery"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
    </application>

</manifest>