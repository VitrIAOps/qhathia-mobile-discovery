<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared cross-feature copy for the Discovery design system. These strings were previously
  duplicated verbatim across two or more feature modules; they live here as the single source of
  truth and are referenced from features via `com.qhathia.mobile.discovery.core.ui.R`.
  Feature-specific copy (even when similar) stays in the owning feature module.
-->
<resources>
