    <string name="discovery_error_network_title">Perdí la conexión…</string>
    <string name="discovery_error_network_message">Parece que la red está inestable. Verifica tu internet e intenta nuevamente.</string>
    <string name="discovery_error_generic_title">Algo salió mal</string>
    <string name="discovery_action_retry">Reintentar</string>

    <!-- Price format -->
    <string name="discovery_price_format">S/ %1$.2f</string>

    <!-- Shared action labels -->
    <string name="discovery_action_back">Volver</string>
    <string name="discovery_action_go_to_catalog">Ir al catálogo</string>
    <string name="discovery_action_new_search">Nueva búsqueda</string>
    <string name="discovery_action_go_to_cart">Ir al carrito</string>
    <string name="discovery_action_add_to_cart">Agregar al carrito</string>
    <string name="discovery_action_share">Compartir</string>

