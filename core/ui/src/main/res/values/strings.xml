    <!-- Close-confirmation dialog -->
    <string name="discovery_dialog_confirm_close">Sí, cerrar</string>
    <!-- Close-dialog message when the basket has products: confirming empties it (CAR-040). -->
    <plurals name="discovery_close_dialog_message_with_cart">
        <item quantity="one">Se vaciará el carrito (%1$d producto) y volverás al inicio.</item>
        <item quantity="other">Se vaciará el carrito (%1$d productos) y volverás al inicio.</item>
    </plurals>
    <string name="discovery_dialog_cancel">Cancelar</string>

    <!-- Shared search prompt + placeholder -->
    <string name="discovery_search_prompt">¿En qué tipo de proyecto lo usarás?</string>
    <string name="discovery_search_placeholder">Describe lo que buscas Ej: hacer huecos en concreto, armar muebles…</string>

    <!-- Voice processing copy (home + product-search) -->
    <string name="discovery_voice_listening">Escuchando</string>
    <string name="discovery_voice_organizing">Organizando ideas</string>
    <string name="discovery_voice_slow_response">Está tardando más de lo que esperaba</string>
    <!-- Product with no photo at all, under the placeholder of the detail's main image (F-43). -->
    <string name="discovery_image_missing">Sin foto</string>
    <!-- Voice search failed for a reason other than the network (F-17). -->
    <string name="discovery_voice_failed">No pude usar el micrófono. Escribe tu búsqueda o inténtalo otra vez.</string>
