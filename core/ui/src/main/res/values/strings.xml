    <plurals name="discovery_cart_added">
        <item quantity="one">Agregaste «%1$s» al carrito</item>
        <item quantity="other">Agregaste %2$d de «%1$s» al carrito</item>
    </plurals>
    <string name="discovery_cart_view">Ver carrito</string>
    <string name="discovery_cart_limit_ok">Entendido</string>
    <!-- Cart control description with the count. -->
    <plurals name="discovery_cd_go_to_cart_count">
        <item quantity="one">Ir al carrito, %d producto</item>
        <item quantity="other">Ir al carrito, %d productos</item>
    </plurals>
